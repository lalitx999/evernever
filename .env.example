# Server-only settings. Never prefix these with NEXT_PUBLIC_.
# Leave CMS unset to keep showing the current imported portfolio.
WORDPRESS_API_URL=
WORDPRESS_BRIDGE_SECRET=
# Enable only AFTER importing and reviewing all portfolio items.
CONTENT_SOURCE=local
# Temporary customer-review showcase: repeat Sulwhasoo as three cards.
# Leave empty to display the selected content source normally. Does not write to CMS.
PORTFOLIO_MOCKUP=
# If the original /wp-content/uploads is served from cms.evernever.net after cutover:
WORDPRESS_MEDIA_ORIGIN=
# Enable only after a real message has arrived in the recipient inbox.
CONTACT_ENABLED=false
# Optional canonical origin. Leave blank for preview deployments with varying hosts.
APP_ORIGIN=
